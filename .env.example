NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Sólo server-side. Se usa para dar de alta usuarios internos (usuario +
# contraseña, sin email real) desde Usuarios. Sacala de tu proyecto de
# Supabase en Settings > API > service_role key. NUNCA la expongas al
# cliente ni le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Dominio público del sitio (usado en metadata, sitemap.xml y robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.pesito.com.ar

# Medición de la web pública (opcionales; sin ID no se carga nada).
# Google Analytics 4: ID de medición "G-XXXXXXXXXX" (Admin > Flujos de datos).
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity: ID del proyecto (Settings > Overview).
NEXT_PUBLIC_CLARITY_ID=

# CAPTCHA (Cloudflare Turnstile, gratis). Se pide sólo cuando una IP está forzando
# el login o el registro. Sin estas dos variables, el CAPTCHA nunca se muestra.
# La pública (NEXT_PUBLIC_) va al navegador; la secreta queda sólo en el servidor.
# Claves de prueba de Cloudflare (siempre pasan): 1x00000000000000000000AA y
# 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
