NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Sólo server-side. Se usa para dar de alta usuarios internos (usuario +
# contraseña, sin email real) desde Usuarios. Sacala de tu proyecto de
# Supabase en Settings > API > service_role key. NUNCA la expongas al
# cliente ni le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Dominio público del sitio (usado en metadata, sitemap.xml y robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.pesito.com.ar

# Medición de la web pública (opcionales; sin ID no se carga nada).
# Google Analytics 4: ID de medición "G-XXXXXXXXXX" (Admin > Flujos de datos).
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity: ID del proyecto (Settings > Overview).
NEXT_PUBLIC_CLARITY_ID=

# CAPTCHA (Cloudflare Turnstile, gratis). Se pide sólo cuando una IP está forzando
# el login o el registro. Sin estas dos variables, el CAPTCHA nunca se muestra.
# La pública (NEXT_PUBLIC_) va al navegador; la secreta queda sólo en el servidor.
# Claves de prueba de Cloudflare (siempre pasan): 1x00000000000000000000AA y
# 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mercado Pago (cobro de los planes). Sólo server-side.
# Access Token de las credenciales de la app (prueba o producción).
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Mercado Pago > tu app > Webhooks).
MP_WEBHOOK_SECRET=
# Opcional: mail al que avisa si falla el webhook de Mercado Pago (con
# RESEND_API_KEY). Sin esta variable usa FEEDBACK_NOTIFY_EMAIL.
BILLING_ALERT_EMAIL=
# Opcional: mail al que llega el aviso de un error nuevo de la app (con RESEND_API_KEY). Sin esta
# variable usa BILLING_ALERT_EMAIL y después FEEDBACK_NOTIFY_EMAIL.
ERROR_ALERT_EMAIL=
# Correos automáticos del ciclo de vida (bienvenida, cargá productos, fin de la prueba, pago
# fallido): la tarea diaria de vercel.json los manda. Vercel le pone este valor en el encabezado
# Authorization; sin él la tarea no hace nada. Poné un texto largo y al azar. Necesita RESEND_API_KEY.
CRON_SECRET=
# Interruptor general de esos correos: APAGADO salvo que valga exactamente "true". Con él apagado
# no sale ninguno (ni la bienvenida del alta ni la tarea diaria), aunque estén las otras dos.
LIFECYCLE_EMAILS_ENABLED=
# Opcional: id del negocio que paga $15 (mínimo de Mercado Pago) el plan mensual (débito automático),
# para probar un cobro real. Dejar vacío en el uso normal.
MP_TEST_ORG_ID=
